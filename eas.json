{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    },
    "production-apk": {
      "distribution": "internal",
      "channel": "production-apk",
      "autoIncrement": true
    },
    "release-phone-apk": {
      "extends": "production-apk",
      "env": {
        "MESHLINE_ANDROID_ARCHS": "arm64-v8a"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "release-emulator-apk": {
      "extends": "production-apk",
      "env": {
        "MESHLINE_ANDROID_ARCHS": "x86_64"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
